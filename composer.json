{
    "name": "badgeteam/hatchery",
    "description": "Hatchery micropython app repository . .",
    "keywords": ["micropython", "badge", "repository"],
    "authors": [
        {
            "name": "Anne Jan Brouwer",
            "email": "brouwer@annejan.com",
            "homepage": "https://annejan.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hatchery@badge.team",
        "isseus": "https://github.com/BadgeTeam/Hatchery/issues"
    },
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_sqlite": "*",
        "ext-phar": "*",
        "ext-zlib": "*",
        "asbiin/laravel-webauthn": "^6.0",
        "bacon/bacon-qr-code": "^3.0",
        "bepsvpt/secure-headers": "^9.1",
        "calebporzio/sushi": "^2.5",
        "czproject/git-php": "^4.6",
        "darkaonline/l5-swagger": "^11.1",
        "intervention/image": "^4.2",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.48",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "pragmarx/google2fa-laravel": "^3.0",
        "pragmarx/recovery": "^0.2",
        "predis/predis": "^3.5",
        "rdx/laravelcollective-html": "^6.10",
        "seld/jsonlint": "^1.12",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-sitemap": "^8.2",
        "symfony/yaml": "^7.0",
        "verschuur/laravel-robotstxt": "^5.3"
    },
    "require-dev": {
        "ext-dom": "*",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.10",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phan/phan": "^5.5",
        "phpunit/phpunit": "^13.0",
        "roave/security-advisories": "dev-latest",
        "slevomat/coding-standard": "^8.31",
        "spatie/laravel-ignition": "^2.12",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse"
        ],
        "lint": [
            "@php vendor/bin/phpcs -q --warning-severity=0"
        ],
        "lint:fix": [
            "@php vendor/bin/phpcbf"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
